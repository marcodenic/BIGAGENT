{
  "name": "big-agent",
  "private": true,
  "version": "0.1.1",
  "desktopName": "big-agent",
  "description": "An ambient room-scale display for autonomous agents",
  "author": "BIG AGENT contributors",
  "license": "MIT",
  "homepage": "https://github.com/marcodenic/BIGAGENT#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcodenic/BIGAGENT.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-vite.mjs",
    "build": "tsc -b && electron-vite build",
    "start": "node scripts/electron-vite.mjs preview",
    "preview": "node scripts/electron-vite.mjs preview",
    "package": "pnpm build && electron-builder",
    "package:dir": "pnpm build && electron-builder --dir",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lobehub/icons-static-svg": "^1.94.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "42.1.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.bigagent.display",
    "productName": "BIG AGENT",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/assets/128x128.png",
        "to": "icon.png"
      },
      {
        "from": "telemetry/otel-collector.yaml",
        "to": "telemetry/otel-collector.yaml"
      },
      {
        "from": "scripts/big-agent.mjs",
        "to": "bin/big-agent.mjs"
      }
    ],
    "linux": {
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "electron/assets/128x128.png"
    },
    "mac": {
      "icon": "electron/assets/icon.icns"
    },
    "win": {
      "icon": "electron/assets/icon.ico"
    }
  }
}
