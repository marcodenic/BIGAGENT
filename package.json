{
  "name": "big-agent",
  "private": true,
  "version": "0.1.11",
  "desktopName": "big-agent",
  "description": "An ambient room-scale display for autonomous agents",
  "author": "BIG AGENT contributors",
  "license": "MIT",
  "homepage": "https://github.com/marcodenic/BIGAGENT#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcodenic/BIGAGENT.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/build-bridge.mjs && node scripts/electron-vite.mjs",
    "build": "tsc -b && electron-vite build && node scripts/build-bridge.mjs",
    "start": "node scripts/electron-vite.mjs preview",
    "preview": "node scripts/electron-vite.mjs preview",
    "package": "pnpm build && electron-builder",
    "package:dir": "pnpm build && electron-builder --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-test.mjs",
    "checksums": "node scripts/checksums.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lobehub/icons-static-svg": "^1.94.0",
    "cross-spawn": "7.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "42.1.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.bigagent.display",
    "productName": "BIG AGENT",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/assets/icon.png",
        "to": "icon.png"
      },
      {
        "from": "telemetry/otel-collector.yaml",
        "to": "telemetry/otel-collector.yaml"
      },
      {
        "from": "out/bridge/big-agent.mjs",
        "to": "bin/big-agent.mjs"
      }
    ],
    "linux": {
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "electron/assets/icon.png"
    },
    "mac": {
      "icon": "electron/assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "artifactName": "BIG-AGENT-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  }
}
