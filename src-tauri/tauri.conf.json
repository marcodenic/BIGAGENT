{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BIG AGENT", "version": "0.1.0", "identifier": "com.bigagent.display",
  "build": { "beforeDevCommand": "pnpm dev", "devUrl": "http://[::1]:1420", "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "app": { "windows": [{ "label": "main", "title": "BIG AGENT", "width": 1280, "height": 800, "minWidth": 420, "minHeight": 320, "maximized": true, "resizable": true, "decorations": true, "alwaysOnTop": false }], "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:;", "devCsp": null } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
